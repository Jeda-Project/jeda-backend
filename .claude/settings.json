{
  "env": {
    "GH_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rtk:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Read(**)",
      "Write(src/**)",
      "Write(.claude/session-logs/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push origin main:*)",
      "Write(.env*)",
      "Write(openapi.json)",
      "Write(drizzle/**)",
      "Write(SSOT.md)",
      "Write(AGENTS.md)",
      "Write(src/app.ts)",
      "Write(src/env.ts)",
      "Write(src/db/index.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/safety-check.sh" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/generated-guard.sh"
          },
          { "type": "command", "command": "bash .claude/hooks/env-guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/auto-format.sh" },
          { "type": "command", "command": "bash .claude/hooks/auto-lint.sh" },
          {
            "type": "command",
            "command": "bash .claude/hooks/safety-keywords-guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/notify.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/stop-check.sh" }
        ]
      }
    ]
  }
}
