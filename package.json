{
  "name": "jeda-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend MVP untuk aplikasi iOS Jeda — journaling & mood check-in",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/db/migrate.ts && bun run src/index.ts",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "fl": "oxfmt --write && oxlint",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openapi:generate": "bun run src/scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@scalar/hono-api-reference": "^0.11.6",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@t3-oss/env-core": "^0.13.10",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.26",
    "hono-openapi": "^1.3.0",
    "stoker": "^2.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.2"
  }
}
