# Environment — copy ke .env lalu isi nilai sebenarnya
NODE_ENV=development

# Port server lokal (Nginx mem-proxy 443 -> port ini di produksi)
PORT=4060

# Neon Postgres serverless connection string (wajib pakai sslmode=require)
# Contoh: postgresql://user:pass@ep-xxx.region.aws.neon.tech/jeda?sslmode=require
DATABASE_URL=

# Gatekeeper Bearer token statis (single-user). Generate string acak >= 24 char.
# Contoh generate: openssl rand -hex 32
API_BEARER_TOKEN=

# Origin yang diizinkan CORS saat produksi (pisahkan koma). Kosong = izinkan semua (dev).
CORS_ORIGINS=
